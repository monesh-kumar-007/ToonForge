# TOONFORGE Web - environment variable reference (non-secret values only).
# Copy to .env for local development; never commit real deployment secrets.

# Backend API base URL used by the web dashboard (apps/web/lib/api.ts).
# Local development default:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production example - set this in your hosting provider UI (Netlify),
# do NOT commit it here:
# NEXT_PUBLIC_API_URL=https://toonforge-api-23n6.onrender.com